{
	"$schema": "https://beepboop.kjanat.dev/schema/v1.json",
	"streams": {
		"git-remote-refs": {
			"packages": [
				"pkg:cargo/git-remote-refs",
				"pkg:npm/git-remote-refs",
				"pkg:golang/github.com/kjanat/git-remote-refs/go"
			],
			"versionScope": "one-for-stream",
			"mustPublish": [
				"pkg:cargo/git-remote-refs",
				"pkg:npm/git-remote-refs"
			],
			"credentials": ["crates-io", "npm-token"],
			"promote": {
				"publishWhen": "approved-in-beepboop",
				"workflow": {
					"file": "release.yml",
					"refs": {
						"phase": "version",
						"prefix": "v",
						"signed": true
					},
					"publications": [
						"pkg:cargo/git-remote-refs",
						"pkg:npm/git-remote-refs"
					]
				}
			}
		}
	},
	"managers": ["cargo", "go", "npm", "workflow"]
}
