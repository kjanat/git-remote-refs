{
	"name": "git-remote-refs",
	"version": "0.0.0",
	"description": "List and resolve refs and fetch objects from public Git repositories over smart HTTP without cloning.",
	"keywords": [
		"git",
		"git-protocol",
		"git-refs",
		"git-objects",
		"ls-remote",
		"smart-http",
		"wasm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/git-remote-refs.git"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/kjanat"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		}
	},
	"files": [
		"index.js",
		"index.d.ts",
		"wasm/"
	],
	"scripts": {
		"build": "mise run build",
		"prepack": "mise run build",
		"prepare": "mise i"
	},
	"devDependencies": {
		"@types/node": "26.6.6"
	},
	"devEngines": {
		"packageManager": {
			"name": "npm",
			"onFail": "ignore"
		}
	}
}
